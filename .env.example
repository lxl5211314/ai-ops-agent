# --- Database ---
DATABASE_URL=mysql+pymysql://xiaolong:xiaolong@localhost:3306/xiaolong?charset=utf8mb4
AUTO_CREATE_TABLES=true

# --- LLM (OpenAI compatible) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-change-me
LLM_MODEL=gpt-4o-mini

# --- Embeddings (OpenAI compatible; 留空则复用上面的 LLM 配置) ---
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- RAG: Milvus / Neo4j / MinIO ---
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=kb_chunks
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=xiaolong-dev
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=xiaolong
MINIO_SECRET_KEY=xiaolong123
MINIO_SECURE=false
MINIO_BUCKET_DOCS=kb-documents
MINIO_BUCKET_ARCHIVES=source-archives

# --- Ingestion safety (colon/semicolon separated absolute roots; EMPTY = reject all path ingestion) ---
INGEST_ALLOWED_ROOTS=
DATA_DIR=./data

# --- CORS (comma separated origins) ---
CORS_ORIGINS=http://localhost:5173
